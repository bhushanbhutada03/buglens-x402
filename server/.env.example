# BugLens Server Environment Configuration

# Execution Environment: 'development', 'test', 'production'
NODE_ENV=development

# Server Port
PORT=8787

# x402 Recipient EVM Wallet Address (must be valid 20-byte address in live production)
PAY_TO_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb

# x402 Facilitator URL (e.g., https://api.x402.org/v2/x402)
FACILITATOR_URL=https://api.x402.org/v2/x402

# Target Blockchain Network (CAIP-2 format, e.g. eip155:84532 for Base Sepolia testnet)
X402_NETWORK=eip155:84532

# Accepted Asset (USDC contract address on target network)
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Diagnostic Report Price in asset base units (e.g. 100000 = 0.10 USDC with 6 decimals)
REPORT_PRICE=100000

# CORS Allowed Origins (comma-separated, NO wildcard in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:8787,http://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
PAID_RATE_LIMIT_MAX=30

# Maximum Request Body Size in Bytes (default: 32KB)
BODY_LIMIT_BYTES=32768

# Facilitator & AI Call Timeouts (milliseconds)
FACILITATOR_TIMEOUT_MS=10000
AI_TIMEOUT_MS=25000

# Optional AI Provider Configuration (needed for real AI reports; mock template used if omitted in mock mode)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Mock Mode (true enables local isolated MockFacilitator; strictly forbidden in production)
MOCK_PAYMENTS=true

# Payer Private Key (ONLY used by server/examples/pay-client.ts for testnet signing, NEVER by the server)
PAYER_PRIVATE_KEY=
